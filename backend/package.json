{
  "name": "jdcali-backend",
  "version": "1.0.0",
  "description": "Node.js Backend for Flotas",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test:inspecciones": "node --experimental-test-module-mocks --test test/inspecciones.test.js",
    "test:programacion-lote": "node --experimental-test-module-mocks --test test/programacionLote.test.js",
    "test:reprogramacion": "node --experimental-test-module-mocks --test test/reprogramacionDestinos.test.js",
    "test:tecnico-cierre": "node --experimental-test-module-mocks --test test/tecnicoCierre.test.js",
    "test:evidencias": "node --experimental-test-module-mocks --test test/evidenciasOt.test.js"
  },
  "dependencies": {
    "axios": "^1.17.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "pdfkit": "^0.18.0",
    "pdfkit-table": "^0.2.11",
    "pg": "^8.11.5",
    "streamifier": "^0.1.1"
  },
  "overrides": {
